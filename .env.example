# Nothing here is required to run locally: every third-party API used is keyless.
# Copy this file to .env (same folder) for local use; on a host, set these as environment variables.

# Production settings
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=your-app.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# Optional: a Stadia Maps API key makes Stadia's hosted Valhalla the primary routing service,
# with the public FOSSGIS server as automatic fallback. Leave empty to use the public server only.
STADIA_API_KEY=

# Optional overrides (defaults shown)
# STADIA_ROUTE_URL=https://api.stadiamaps.com/route/v1
# VALHALLA_URL=https://valhalla1.openstreetmap.de/route
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# PHOTON_URL=https://photon.komoot.io/api/
# CACHE_TTL_ROUTES=600
# CACHE_TTL_WEATHER=1800
# CACHE_TTL_GEOCODE=86400
# THROTTLE_ANALYZE=30/min
# THROTTLE_GEOCODE=120/min
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark   (build time)
